{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/cli.ts",
    "src/index.ts",
    "tests/**/*.test.ts",
    "examples/setup/*.ts",
    "examples/report-examples.ts",
    "action/run.ts",
    "scripts/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "fixtures/**/*.ts",
    "examples/**/*.ts",
    "ui/**/*.{ts,svelte}",
    "action/**/*.ts",
    "scripts/**/*.ts"
  ]
}
