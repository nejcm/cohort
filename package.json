{
  "name": "cohort-lab",
  "version": "0.1.0-rc.0",
  "description": "AI synthetic users that operate your web app and leave an inspectable Playwright trail.",
  "keywords": [
    "agent",
    "llm",
    "playwright",
    "synthetic-users",
    "testing",
    "ux"
  ],
  "license": "Apache-2.0",
  "bin": {
    "cohort": "dist/cli.js"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "files": [
    "dist",
    "examples/personas",
    "examples/suites/*-pack.yml",
    "skills/cohort",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && vite build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=120000 tests/unit/ tests/integration/",
    "knip": "knip",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run knip",
    "seed": "node scripts/seed.ts",
    "smoke:package": "node scripts/package-smoke.ts"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "knip": "6.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "svelte": "5.57.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "packageManager": "bun@1.4.4"
}
